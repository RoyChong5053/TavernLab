AGE_STYLE = {"fresh": "bold green", "warm": "bold yellow", "cold": "bold red"}
AGE_MARK = {"fresh": "●", "warm": "●", "cold": "●"}


class Stats:
    """面板要显示的运行时状态。"""

    def __init__(self):
        self.rounds = 0
        self.skips = 0
        self.started = time.monotonic()
        self.history = []       # [(时间, 状态, 文本), ...] 最多 HIST_MAX 行
        self.last_fix = None
        self.last_dist_m = None  # 距上一点的距离
        self.interval_now = INTERVAL
        self.adaptive = False
        self.state = "启动中"
        self.state_style = "cyan"
        self.next_at = None

    HIST_MAX = 8

    def add(self, ok, text):
        self.history.append((time.strftime("%H:%M"), ok, text))
        if len(self.history) > self.HIST_MAX:
            self.history.pop(0)


def build_rich(st, poster, cfg, console):
    """构造 rich 布局。宽屏左右分栏, 窄屏自动上下堆叠。

    console 必须由调用方传进来 —— 自己 new 一个 Console() 量的是真实终端宽度,
    而 Live 可能被限制成别的宽度, 两者不一致会让「窄屏」分支永远不生效。
    """
    wide = console.width >= 76

    # --- 头部 ---
    up = int(time.monotonic() - st.started)
    up_s = "%02d:%02d" % (up // 3600, (up % 3600) // 60)
    head = Text.from_markup(
        "[bold]%s[/]  %s  m64 [cyan]%s[/]  间隔 [cyan]%ds[/]%s\n"
        "运行 [cyan]%s[/] · 第 [cyan]%d[/] 轮 · %s"
        % (st.state, "●" if st.state_style == "green" else "○",
           cfg["host"], st.interval_now,
           "  [dim](静止自适应)[/]" if st.adaptive else "",
           up_s, st.rounds, time.strftime("%H:%M:%S")),
        style=st.state_style if st.state != "已连接" else "bold",
    )
    header = Panel(head, border_style=st.state_style, box=box.ROUNDED,
                   padding=(0, 1))

    # --- 定位面板 ---
    lt = Table(show_header=False, box=box.SIMPLE, padding=(0, 1),
               expand=True, collapse_padding=True)
    lt.add_column("k", width=10, style="dim", no_wrap=True)
    lt.add_column("v", ratio=1, overflow="fold")
    f = st.last_fix
    if f:
        lt.add_row("provider", f.provider)
        lt.add_row("坐标", "%s" % f)
        lt.add_row("精度", "±%.0f m" % f.acc if f.acc else "未知")
        lvl = f.stale_level
        lt.add_row("点龄", "[%s]%s %s[/]" % (AGE_STYLE[lvl], AGE_MARK[lvl],
                                             f.age_text()))
        if st.last_dist_m is not None:
            lt.add_row("距上点", "%.1f m" % st.last_dist_m)
    else:
        lt.add_row("状态", "[dim]尚未取到定位[/]")
    loc_panel = Panel(lt, title="[bold cyan]定位[/]",
                      border_style="cyan", box=box.ROUNDED, padding=(0, 1))

    # --- 发送面板 ---
    rt = Table(show_header=False, box=box.SIMPLE, padding=(0, 1),
               expand=True, collapse_padding=True)
    rt.add_column("k", width=10, style="dim", no_wrap=True)
    rt.add_column("v", ratio=1, overflow="fold")
    if not poster.enabled:
        rt.add_row("模式", "[yellow]未发送 (--no-post)[/]")
    elif poster.last_code in HTTP_OK:
        rt.add_row("上次", "[green]%d OK[/]  [dim]%dms[/]"
                   % (poster.last_code, poster.last_ms or 0))
    elif poster.last_code is not None:
        rt.add_row("上次", "[red]%d %s[/]"
                   % (poster.last_code, poster.last_error or ""))
    else:
        rt.add_row("上次", "[dim]尚未发送[/]")
    if poster.place:
        short = poster.place
        # 层级里最后一个和 place 相同的就不重复显示了
        for h in reversed(poster.hierarchy):
            if h and h != short:
                short += ", " + h
                break
        rt.add_row("地点", short)
    rt.add_row("成功/失败", "[green]%d[/] / [red]%d[/]"
               % (poster.ok_count, poster.fail_count))
    if poster.retried:
        rt.add_row("补发", "[green]%d[/]" % poster.retried)
    send_panel = Panel(rt, title="[bold magenta]发送[/]",
                       border_style="magenta", box=box.ROUNDED, padding=(0, 1))

    if wide:
        from rich.columns import Columns
        mid = Columns([loc_panel, send_panel], expand=True, equal=True)
    else:
        mid = Group(loc_panel, send_panel)

    # --- 轮次历史 ---
    # 窄屏时 7 列会被 rich 挤到全是省略号, 所以窄屏改用「时间+标记+摘要」
    # 三列, 摘要自己拼成一行。
    if wide:
        ht = Table(box=box.SIMPLE, expand=True, collapse_padding=True,
                   padding=(0, 1))
        ht.add_column("时间", width=7, style="dim", no_wrap=True)
        ht.add_column("", width=1, no_wrap=True)
        ht.add_column("来源", width=8, no_wrap=True)
        ht.add_column("精度", width=7, no_wrap=True)
        ht.add_column("点龄", width=9, no_wrap=True)
        ht.add_column("HTTP", width=7, no_wrap=True)
        ht.add_column("耗时", width=7, no_wrap=True)
        for t, ok, txt in st.history:
            ht.add_row(t, "[green]●[/]" if ok else "[red]○[/]",
                       txt[0], txt[1], txt[2], txt[3], txt[4])
    else:
        ht = Table(box=box.SIMPLE, expand=True, collapse_padding=True,
                   padding=(0, 1), show_header=False)
        ht.add_column("时间", width=7, style="dim", no_wrap=True)
        ht.add_column("", width=1, no_wrap=True)
        ht.add_column("摘要", ratio=1, overflow="ellipsis", no_wrap=True)
        for t, ok, txt in st.history:
            ht.add_row(t, "[green]●[/]" if ok else "[red]○[/]",
                       " ".join(x for x in txt if x != "-"))
    hist_panel = Panel(ht, title="[bold blue]轮次[/]",
                       border_style="blue", box=box.ROUNDED, padding=(0, 1))

    # --- 底部状态栏 ---
    ok_n, skip_n = st.rounds - st.skips, st.skips
    if st.next_at:
        left = max(0, int(st.next_at - time.time()))
        bar = Progress(bar_width=16, total=max(1, st.interval_now),
                       completed=max(0, st.interval_now - left))
        countdown = "下轮 %02d:%02d %s" % (left // 60, left % 60, bar.text)
    else:
        countdown = ""
    footer = Text.from_markup(
        "成功 [green]%d[/] · 失败 [red]%d[/] · 跳过 [yellow]%d[/] · %s\n"
        "[dim][q]退出  [空格]立即取点[/]"
        % (ok_n, poster.fail_count, skip_n, countdown))

    return Group(header, mid, hist_panel, footer)


class Progress:
    def __init__(self, bar_width, total, completed):
        self.bar_width = bar_width
        self.total = total
        self.completed = completed

    @property
    def text(self):
        frac = 0.0 if self.total <= 0 else min(1.0, self.completed / self.total)
        n = int(frac * self.bar_width)
        return "█" * n + "░" * (self.bar_width - n)


def build_plain(st, poster, cfg):
    """没有 rich 时的降级渲染: 纯文本 + 清屏。"""
    lines = []
    up = int(time.monotonic() - st.started)
    lines.append("=== GPS Logger ===")
    lines.append("%s  m64 %s  间隔 %ds%s" % (
        st.state, cfg["host"], st.interval_now,
        "  (静止自适应)" if st.adaptive else ""))
    lines.append("运行 %02d:%02d · 第 %d 轮 · %s" % (
        up // 3600, (up % 3600) // 60, st.rounds, time.strftime("%H:%M:%S")))
    lines.append("-" * 40)
    f = st.last_fix
    if f:
        lines.append("  provider  %s" % f.provider)
        lines.append("  坐标      %s" % f)
        lines.append("  精度      ±%.0f m" % f.acc if f.acc else "  精度      未知")
        lines.append("  点龄      %s %s" % (AGE_MARK[f.stale_level], f.age_text()))
        if st.last_dist_m is not None:
            lines.append("  距上点    %.1f m" % st.last_dist_m)
    else:
        lines.append("  尚未取到定位")
    lines.append("-" * 40)
    if not poster.enabled:
        lines.append("  模式      未发送 (--no-post)")
    elif poster.last_code in HTTP_OK:
        lines.append("  上次      %d OK  %dms" % (poster.last_code,
                                                 poster.last_ms or 0))
    elif poster.last_code is not None:
        lines.append("  上次      %d %s" % (poster.last_code,
                                            poster.last_error or ""))
    else:
        lines.append("  上次      尚未发送")
    if poster.place:
        lines.append("  地点      %s" % poster.place)
    lines.append("  成功/失败  %d / %d" % (poster.ok_count, poster.fail_count))
    lines.append("-" * 40)
    for t, ok, txt in st.history[-5:]:
        lines.append("  %s %s %s" % (
            t, "+" if ok else "-",
            " ".join(x for x in txt if x != "-")))
    if st.next_at:
        left = max(0, int(st.next_at - time.time()))
        lines.append("  成功 %d · 失败 %d · 跳过 %d · 下轮 %02d:%02d" % (
            st.rounds - st.skips, poster.fail_count, st.skips,
            left // 60, left % 60))
    lines.append("  [q]退出  [空格]立即取点")
    return "\n".join(lines)


# ---- 主循环 ---------------------------------------------------------------
def one_round(st, poster, cfg, force_post=True):
    """跑一轮: 取定位 -> 上报 -> 更新面板状态。返回本轮是否成功。"""
    st.rounds += 1
    st.state = "取定位中"
    st.state_style = "cyan"

    fix, debug = get_fix()
    if not fix:
        st.skips += 1
        st.state = "取不到定位"
        st.state_style = "yellow"
        st.add(False, ("-", "-", "-", "-", "-"))
        log("SKIP 取不到定位 [%s]" % debug)
        return False

    prev = st.last_fix
    if prev is not None:
        st.last_dist_m = haversine_m(prev.lat, prev.lon, fix.lat, fix.lon)
    st.last_fix = fix

    # 自适应间隔: 位移小就降频省电, 但静止期照常采样 (dwell 推断依赖连续点位)
    if st.last_dist_m is not None and st.last_dist_m < STILL_METERS:
        st.interval_now = INTERVAL_STILL
        st.adaptive = True
    else:
        st.interval_now = INTERVAL
        st.adaptive = False

    batt = get_battery()
    sent = poster.send(fix, batt) if force_post else True

    # 连续失败够多次 -> 重启 Termux:API 自愈。其 KeepAliveService 可能已僵死,
    # 光等没用。借鉴 BuriXon-code 的 Termux-GPS-Tracker, 但只在真失败时触发,
    # 正常路径绝不碰 (重启会让本来 1 秒能好的调用变成几秒)。
    healed = False
    if not sent and poster.consec_fail >= RETRY_EVERY:
        poster.heal_api()
        poster.consec_fail = 0
        healed = True

    if healed:
        st.state = "上报失败·已重启API"
        st.state_style = "yellow"
    else:
        st.state = "已连接" if sent else "上报失败"
        st.state_style = "green" if sent else "red"
    http = (str(poster.last_code) if poster.last_code else "-")
    ms = ("%dms" % poster.last_ms) if poster.last_ms is not None else "-"
    st.add(sent, (fix.provider,
                  ("±%.0fm" % fix.acc) if fix.acc else "-",
                  fix.age_text(), http, ms))
    return sent


def loop(st, poster, cfg):
    """前台主循环。Ctrl-C 或 q 退出。空格立即触发一轮。"""
    import termios
    import tty

    # 开场先补发上次没发出去的点
    poster.retry_last()

    console = Console() if HAS_RICH else None
    # 退出时恢复光标和 echo, 否则 Ctrl-C 后终端是花的
    fd = sys.stdin.fileno()
    old_attrs = None
    try:
        old_attrs = termios.tcgetattr(fd)
        tty.setcbreak(fd)
    except (termios.error, ValueError, OSError):
        pass  # 不是 tty (比如被重定向), 就用普通输入

    def cleanup():
        if old_attrs is not None:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_attrs)
            except (termios.error, ValueError, OSError):
                pass
        if console is not None:
            console.print("\n[dim]已退出 · 本次成功 %d 失败 %d 跳过 %d[/]"
                          % (poster.ok_count, poster.fail_count, st.skips))
        else:
            print("\n已退出 · 成功 %d 失败 %d 跳过 %d"
                  % (poster.ok_count, poster.fail_count, st.skips))

    try:
        if HAS_RICH:
            with Live(console=console, refresh_per_second=4,
                      screen=True) as live:
                while not _STOP[0]:
                    one_round(st, poster, cfg)
                    st.next_at = time.time() + st.interval_now
                    live.update(build_rich(st, poster, cfg, console))
                    # 间隔内可按空格打断立刻取点, 也能被 Ctrl-C 打断
                    end = time.time() + st.interval_now
                    while not _STOP[0] and time.time() < end:
                        try:
                            if select_has_input(fd, 0.4):
                                ch = os.read(fd, 1).decode("utf-8", "replace")
                                if ch in ("q", "Q", "\x03"):
                                    _STOP[0] = True
                                    break
                                if ch == " ":
                                    end = 0
                                    break
                        except OSError:
                            break
        else:
            while not _STOP[0]:
                one_round(st, poster, cfg)
                st.next_at = time.time() + st.interval_now
                print("\033[2J\033[H" + build_plain(st, poster, cfg))
                end = time.time() + st.interval_now
                while not _STOP[0] and time.time() < end:
                    time.sleep(0.4)
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()


def select_has_input(fd, timeout):
    """有输入就返回 True。用 select 而不是直接 read, 否则会阻塞。"""
    import select
    try:
        r, _, _ = select.select([fd], [], [], timeout)
        return bool(r)
    except (OSError, ValueError):
        return False


# ---- CLI ------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(
        description="GT20 地理位置反馈 -> m64 TavernLab -> 对话上下文")
    ap.add_argument("--once", action="store_true",
                    help="取一个点就退出 (可放进 cron)")
    ap.add_argument("--interval", type=int, default=None,
                    help="基础间隔秒 (默认读配置, 再默认 600)")
    ap.add_argument("--plain", action="store_true",
                    help="强制纯文本输出, 不用 rich")
    ap.add_argument("--no-post", action="store_true",
                    help="只本地显示, 不发 m64 (调试用)")
    ap.add_argument("--host", default=None, help="覆盖配置里的 HOST")
    ap.add_argument("--token", default=None, help="覆盖配置里的 TOKEN")
    args = ap.parse_args()

    cfg = load_env_file()
    host = args.host or cfg.get("HOST")
    token = args.token or cfg.get("TOKEN")
    if not host:
        die("配置里没有 HOST (m64 TavernLab, 如 http://192.168.100.78:8888)")
    if not token:
        die("配置里没有 TOKEN (app_token)")
    cfg["host"] = host

    if args.interval:
        globals()["INTERVAL"] = args.interval
        globals()["INTERVAL_STILL"] = max(args.interval * 2, args.interval + 60)
    elif cfg.get("GL_INTERVAL"):
        try:
            globals()["INTERVAL"] = int(cfg["GL_INTERVAL"])
            globals()["INTERVAL_STILL"] = INTERVAL * 2
        except ValueError:
            pass

    if args.plain:
        global HAS_RICH
        HAS_RICH = False

    if not shutil.which("termux-location"):
        die("缺 termux-location (装 com.termux.api 并给位置权限)")

    signal.signal(signal.SIGINT, _on_signal)
    signal.signal(signal.SIGTERM, _on_signal)

    D.mkdir(parents=True, exist_ok=True)
    log("=== start v1 host=%s interval=%ds post=%s ==="
        % (host, INTERVAL, not args.no_post))

    st = Stats()
    st.interval_now = INTERVAL
    poster = Poster(host, token, enabled=not args.no_post)

    if args.once:
        one_round(st, poster, cfg)
        f = st.last_fix
        if f:
            print("lat=%s lon=%s acc=%s prov=%s age=%s"
                  % (f.lat, f.lon, f.acc, f.provider, f.age_text()))
        else:
            print("取不到定位")
        if poster.last_code is not None:
            print("http=%s %s" % (poster.last_code, poster.last_error or "OK"))
        if poster.place:
            print("place=%s" % poster.place)
        return 0 if f else 1

    loop(st, poster, cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
