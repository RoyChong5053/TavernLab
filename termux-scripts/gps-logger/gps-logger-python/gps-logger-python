def _on_signal(signum, frame):
    """信号处理: 只置标志位, 真正的退出交给主循环收尾 (恢复终端属性)。"""
    _STOP[0] = True


# ---- config ---------------------------------------------------------------
def load_env_file():
    """读 ~/.config/gps-logger/env。格式是 KEY=VALUE 的 shell 片段。"""
    if not CONF.exists():
        die("缺少 %s, 先跑 install.sh" % CONF)
    cfg = {}
    for line in CONF.read_text(encoding="utf-8", errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, v = line.partition("=")
        cfg[k.strip()] = v.strip().strip("'\"")
    return cfg


def die(msg):
    log("FATAL %s" % msg)
    print("gps-logger: %s" % msg, file=sys.stderr)
    sys.exit(1)


def ts():
    return time.strftime("%F %T")


def log(msg):
    """追加到日志文件。日志目录可能还不存在。"""
    try:
        D.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as f:
            f.write("%s %s\n" % (ts(), msg))
    except OSError:
        pass  # 日志失败不能拖垮主流程


# ---- 定位 -----------------------------------------------------------------
class Fix:
    """一次定位结果。age_s 是点位年龄 (从 elapsedMs 算), 用来如实展示新鲜度。"""

    def __init__(self, lat, lon, acc, provider, age_s, speed=None, bearing=None):
        self.lat = lat
        self.lon = lon
        self.acc = acc
        self.provider = provider
        self.age_s = age_s
        self.speed = speed
        self.bearing = bearing

    @property
    def stale_level(self):
        """点龄分级: fresh / warm / cold。面板按这个上色。"""
        if self.age_s is None:
            return "fresh"
        if self.age_s < 300:
            return "fresh"
        if self.age_s < 1800:
            return "warm"
        return "cold"

    def age_text(self):
        if self.age_s is None:
            return "未知"
        s = int(self.age_s)
        if s < 60:
            return "%d秒前" % s
        if s < 3600:
            return "%d分钟前" % (s // 60)
        return "%d小时前" % (s // 3600)

    def __str__(self):
        return "%.6f,%.6f" % (self.lat, self.lon)


def run_api(cmd, timeout):
    """跑一个 termux-api 包装脚本, 带硬超时。

    timeout 必须大于该 API 的内部最坏等待, 否则就是"杀在飞行中" ->
    Termux:API 报错弹窗。这里所有调用都用 -r last 这种瞬回的, timeout 只是
    防挂死的安全网, 给得比实际耗时长得多。
    """
    try:
        r = subprocess.run(cmd, capture_output=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return ""
    except OSError:
        return ""
    return r.stdout.decode("utf-8", errors="replace")


def parse_location(raw):
    """termux-location 的 JSON -> Fix。失败返回 None。

    注意 API_ERROR 字段: 权限缺失/取不到时 Termux:API 会返回
    {"API_ERROR": "..."} 而不是空, 别把它当成有效点位。
    """
    if not raw:
        return None
    try:
        d = json.loads(raw)
    except json.JSONDecodeError:
        return None
    if not isinstance(d, dict) or "API_ERROR" in d:
        return None
    lat = d.get("latitude")
    lon = d.get("longitude")
    if lat is None or lon is None:
        return None
    try:
        lat, lon = float(lat), float(lon)
    except (TypeError, ValueError):
        return None
    # 越界的基本不是有效坐标
    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
        return None

    def num(key):
        v = d.get(key)
        try:
            return float(v) if v is not None else None
        except (TypeError, ValueError):
            return None

    elapsed = num("elapsedMs")
    return Fix(
        lat=lat,
        lon=lon,
        acc=num("accuracy"),
        provider=d.get("provider") or "unknown",
        age_s=(elapsed / 1000.0) if elapsed is not None else None,
        speed=num("speed"),
        bearing=num("bearing"),
    )


def get_fix():
    """按 PROVIDERS 顺序取定位, 拿到第一个有效的就返回。

    一律 `-r last`: 读缓存瞬回。**不要**改成默认的 once, 理由见文件头。
    返回 (fix, debug) —— debug 记每个 provider 的返回字节数, 方便排障。
    """
    debug = []
    for p in PROVIDERS:
        raw = run_api(["termux-location", "-p", p, "-r", "last"],
                      PROV_TIMEOUT.get(p, 25))
        debug.append("%s%d" % (p[:1], len(raw)))
        fix = parse_location(raw)
        if fix:
            return fix, "/".join(debug)
    return None, "/".join(debug)


def get_battery():
    """电量百分比。拿不到返回 0 (服务端 omitempty, 不影响)。"""
    raw = run_api(["termux-battery-status"], BATTERY_TIMEOUT)
    if not raw:
        return 0
    try:
        pct = json.loads(raw).get("percentage")
        return int(pct) if pct is not None else 0
    except (json.JSONDecodeError, TypeError, ValueError):
        return 0


# ---- 上报 -----------------------------------------------------------------
def haversine_m(lat1, lon1, lat2, lon2):
    """两点距离(米)。公式与服务端 location.go:254 haversineKm 一致。"""
    r = 6371000.0
    dlat = math.radians(lat2 - lat1)
    dlon = math.radians(lon2 - lon1)
    a = (math.sin(dlat / 2) ** 2
         + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2))
         * math.sin(dlon / 2) ** 2)
    return 2 * r * math.asin(math.sqrt(a))


class Poster:
    """POST 到 m64。记录最近一次结果给面板显示。"""

    def __init__(self, host, token, enabled=True):
        self.host = host.rstrip("/")
        self.token = token
        self.enabled = enabled
        self.last_code = None
        self.last_ms = None
        self.last_error = None
        self.place = ""
        self.hierarchy = []
        self.ok_count = 0
        self.fail_count = 0
        self.consec_fail = 0
        self.retried = 0

    def _send(self, payload):
        body = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            self.host + "/api/location",
            data=body,
            headers={
                "Authorization": "Bearer " + self.token,
                "Content-Type": "application/json",
            },
            method="POST",
        )
        start = time.monotonic()
        try:
            with urllib.request.urlopen(req, timeout=POST_TIMEOUT) as resp:
                self.last_ms = int((time.monotonic() - start) * 1000)
                self.last_code = resp.status
                if resp.status in HTTP_OK:
                    try:
                        d = json.loads(resp.read().decode("utf-8"))
                        if isinstance(d, dict):
                            self.place = d.get("place") or ""
                            self.hierarchy = d.get("hierarchy") or []
                    except (json.JSONDecodeError, UnicodeDecodeError):
                        pass
                    return True
                self.last_error = "HTTP %d" % resp.status
                return False
        except urllib.error.HTTPError as e:
            self.last_ms = int((time.monotonic() - start) * 1000)
            self.last_code = e.code
            self.last_error = "HTTP %d" % e.code
            return False
        except Exception as e:  # noqa: BLE001 - 网络异常种类多, 一律降级为失败
            self.last_ms = int((time.monotonic() - start) * 1000)
            self.last_code = None
            self.last_error = type(e).__name__
            return False

    def send(self, fix, batt):
        """上报一个点。enabled=False 时只本地记账, 不发网络。"""
        payload = {
            "lat": fix.lat,
            "lon": fix.lon,
            "acc": fix.acc or 0,
            "provider": fix.provider,
            "tst": int(time.time()),
            "batt": batt,
        }
        if not self.enabled:
            self.last_code = None
            self.last_error = None
            return True
        # 先落盘再发: 万一发到一半被 Ctrl-C, 下次启动还能补发
        try:
            D.mkdir(parents=True, exist_ok=True)
            LAST_JSON.write_text(json.dumps(payload), encoding="utf-8")
        except OSError:
            pass
        if self._send(payload):
            self.ok_count += 1
            self.consec_fail = 0
            log("OK lat=%.6f lon=%.6f acc=%s prov=%s batt=%s age=%s"
                % (fix.lat, fix.lon, fix.acc, fix.provider, batt, fix.age_text()))
            return True
        self.fail_count += 1
        self.consec_fail += 1
        log("FAIL %s lat=%.6f lon=%.6f (consec=%d)"
            % (self.last_error, fix.lat, fix.lon, self.consec_fail))
        return False

    def retry_last(self):
        """补发上次没发出去的点 (重启/崩溃后调一次)。"""
        if not self.enabled or not LAST_JSON.exists():
            return False
        try:
            payload = LAST_JSON.read_text(encoding="utf-8").strip()
        except OSError:
            return False
        if not payload:
            return False
        if self._send(payload):
            self.retried += 1
            log("RETRY OK")
            try:
                LAST_JSON.unlink()
            except OSError:
                pass
            return True
        log("RETRY FAIL %s" % self.last_error)
        return False

    def heal_api(self):
        """重启 Termux:API 自愈。

        借鉴自 BuriXon-code 的 Termux-GPS-Tracker: 取定位反复失败时,
        Termux:API 的 KeepAliveService 可能已经僵死, 光等没用, 重启它。
        实测本机存在:
          termux-api-stop  -> am stopservice -n com.termux.api/.KeepAliveService
          termux-api-start -> am startservice  -n com.termux.api/.KeepAliveService
        **只在连续失败够多次后调用**, 正常路径绝不碰。
        """
        log("heal: restart Termux:API (consec_fail=%d)" % self.consec_fail)
        for cmd in ("termux-api-stop", "termux-api-start"):
            if shutil.which(cmd):
                run_api([cmd], 15)
        time.sleep(2)  # 等 API 进程起来


